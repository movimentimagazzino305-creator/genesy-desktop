!macro customHeader
  !define MUI_WELCOMEPAGE_TITLE "Benvenuto in Genesy Desktop"
  !define MUI_WELCOMEPAGE_TEXT "Stai per installare Genesy Desktop, la piattaforma software di Parquet Romagna per la gestione dei preventivi, clienti e cantieri.$\r$\n$\r$\nQuesto programma guidato configurerà l'applicazione sul tuo computer ed aggiungerà automaticamente la scorciatoia sul Desktop.$\r$\n$\r$\nPer iniziare la procedura di installazione, fai clic su Avanti."
  !define MUI_PAGE_HEADER_TEXT "Genesy Desktop - Parquet Romagna"
  !define MUI_PAGE_HEADER_SUBTEXT "Installazione del software sul tuo PC"
  !define MUI_FINISHPAGE_TITLE "Installazione di Genesy Desktop completata!"
  !define MUI_FINISHPAGE_TEXT "Genesy Desktop è stato installato con successo ed è pronto all'uso.$\r$\n$\r$\nPuoi avviare subito l'applicazione o ritrovarla quando vuoi sul tuo Desktop."
  !define MUI_FINISHPAGE_RUN "$INSTDIR\Genesy Desktop.exe"
  !define MUI_FINISHPAGE_RUN_TEXT "Avvia Genesy Desktop adesso"
!macroend
